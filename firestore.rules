rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.uid == '7lNa6gWSDxb7kgR1AR8VEeKPgap2';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // sentNotifIds е server-only — само claimNotif() (Cloud Function, Admin SDK,
      // заобикаля тези rules изцяло) го пипа. Клиентът никога не го подава в
      // notifs-related writes, затова блокирането му тук не пречи на нормалната
      // употреба, само предотвратява директна манипулация (вижте одита — client
      // писане на "sent" статус беше архитектурен риск, вече елиминиран структурно
      // чрез отделянето му от notifs масива, тук се заключва и на rules ниво).
      //
      // create/update разделени умишлено — diff(resource.data) изисква съществуващ
      // resource, а при create (регистрация, първият setDoc за users/{uid}) resource
      // е null и diff() гърми с грешка, което rules engine-ът оценява като deny. Това
      // счупи регистрацията изцяло в production (потвърдено с реален E2E тест
      // 2026-07-28): setDoc-ът за новия профил гърмеше с permission-denied, което
      // тригерваше rollback-а в doAuthUnified/doPsAuthUnified и триеше току-що
      // създадения Auth акаунт — потребителят виждаше "грешна парола" при опит да
      // влезе с абсолютно същите данни, без никаква индикация какво се е случило.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['referralCount', 'unlockedRewards', 'sentNotifIds']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['referralCount', 'unlockedRewards', 'sentNotifIds']);
    }
    match /diary_entries/{entryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.type in ['idea', 'bug', 'content'];
      allow read, update, delete: if isAdmin();
    }
    match /app_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /clinic_ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliate_clicks/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /search_logs/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /clinic_inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /clinic_registrations/{docId} {
      // ОТДЕЛНА от clinic_inquiries — тя е обща B2B заявка за интерес, тук е
      // конкретна идентификационна регистрация (ЕИК/БУЛСТАТ) за marketplace-а
      // за сравнение на цени. Public create, защото клиниката още няма акаунт
      // в момента на подаване (акаунтът, ако изобщо се стигне дотам, се
      // създава от админ СЛЕД одобрение — виж работния документ).
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /clinics/{clinicId} {
      // Публично четим — клиентският сравнителен списък трябва да покаже
      // името/града на клиниката до цената, дори за нелогнат потребител.
      allow read: if true;
      allow write: if isAdmin();
      // Self-serve панел (#page-clinic в index.html) — клиниката пипа само
      // собствения си КОНТАКТЕН профил, изрично изброени полета. НИКОГА
      // 'status' (само админ одобрява/спира), 'eik' (правен идентификатор),
      // 'email' (Auth самоличността ѝ), 'createdAt'/'approvedAt' (сървърни).
      allow update: if isSignedIn() && request.auth.uid == clinicId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'address', 'phone', 'website', 'contactPerson', 'vatRegistered', 'updatedAt']);
    }
    match /clinic_prices/{priceId} {
      // Клиниката пише само собствените си редове (clinicOwnerUid == uid) и само
      // след одобрение (виж isApprovedClinic()) — самото писане никога не е
      // заключено зад плащане (решено изрично: "въвеждането не спира" дори след
      // пробния период). Кое от вече написаното е ВИДИМО за клиентите заради
      // плащане е бъдещ, отделен слой (виж "Отворени въпроси"/"Решения" в работния
      // документ) — не се прилага тук, докато клиничните абонаменти не съществуват.
      function isApprovedClinic() {
        return isSignedIn() && get(/databases/$(database)/documents/clinics/$(request.auth.uid)).data.status == 'approved';
      }
      allow read: if true;
      // `|| isAdmin()` на create/update — admin панелът (#page-admin →
      // "Одобрени клиники" → "Отвори", adminOpenClinic() в index.html)
      // позволява на админ да редактира цените на РЕАЛНА клиника от нейно
      // име (напр. клиника моли по телефона за корекция) — записва с
      // истинския clinicOwnerUid на клиниката, не на админ акаунта, затова
      // проверката "request.resource.data.clinicOwnerUid == request.auth.uid"
      // сама по себе си не би минала за админ и трябва отделен клон.
      allow create: if (isApprovedClinic()
        && request.resource.data.clinicOwnerUid == request.auth.uid) || isAdmin();
      allow update: if (isApprovedClinic()
        && resource.data.clinicOwnerUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clinicOwnerUid'])) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.clinicOwnerUid == request.auth.uid) || isAdmin();
    }
    match /admin_notifications/{notifId} {
      // Пълни се САМО от notifyOnClinicPriceChange (Cloud Function, Admin SDK,
      // заобикаля тези правила изцяло) — клиентът никога не създава известия сам,
      // иначе всеки логнат клиничен акаунт би могъл да си "измисли" фалшива история.
      allow create: if false;
      allow read: if isAdmin();
      // Ограничено до точно тези два ключа — "Прегледай" бутонът в админ панела
      // не бива случайно да презаписва clinicName/summary/createdAt на известието.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed', 'reviewedAt']);
      allow delete: if isAdmin();
    }
    match /referrals/{referralId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.refereeUid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
        && request.auth.uid in [resource.data.referrerUid, resource.data.refereeUid];
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
